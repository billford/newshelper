<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site_title }} — {{ build_date.strftime('%B %d, %Y') }}</title>
  <link rel="icon" href="static/brand/favicon.svg" type="image/svg+xml">
  <link rel="alternate icon" href="static/brand/favicon.ico">
  <link rel="apple-touch-icon" href="static/brand/apple-touch-icon-180.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Inter:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="static/css/style.css">
</head>
<body>
  {#
    STANDING RULE: every tag/badge kind rendered on the page (category,
    satire, fact-check, and each go-deeper "kind") must have a matching
    entry in this legend. Add a row here in the same change that
    introduces a new tag -- e.g. a future "paper" go-deeper kind, or any
    new badge -- so the legend never drifts out of sync with what the
    page actually shows.
  #}
  <header class="masthead">
    <div class="masthead-inner">
      <div class="masthead-brand">
        {% if wordmark_svg %}
        <div class="wordmark">{{ wordmark_svg | safe }}</div>
        {% else %}
        <h1>{{ site_title }}</h1>
        <p class="tagline">{{ site_tagline }}</p>
        {% endif %}
        <p class="dateline">{{ build_date.strftime('%A, %B %d, %Y') }}</p>
        <p class="page-published">Published {{ build_date.strftime('%B %d, %Y') }} at {{ build_date.strftime('%-I:%M %p') }} UTC</p>
        <nav class="masthead-nav" aria-label="Site navigation">
          <a href="about.html">About this project</a>
        </nav>
      </div>
      <aside class="legend" aria-label="Tag legend">
        <p class="legend-heading">Tag legend</p>
        <ul class="legend-list">
          <li><span class="category-badge legend-swatch">TOPIC</span><span class="legend-text">Story category</span></li>
          <li><span class="satire-badge legend-swatch">SATIRE</span><span class="legend-text">Known satire/parody source</span></li>
          <li><span class="factcheck-badge legend-swatch">FACT-CHECKED</span><span class="legend-text">A similar claim was independently fact-checked</span></li>
          <li><span class="kind-tag kind-article legend-swatch">ARTICLE</span><span class="legend-text">Suggested further reading</span></li>
          <li><span class="kind-tag kind-book legend-swatch">BOOK</span><span class="legend-text">Suggested book, verified before publishing</span></li>
          <li><span class="kind-tag kind-source legend-swatch">SOURCE</span><span class="legend-text">Original article the summary was built from</span></li>
        </ul>
      </aside>
    </div>
  </header>

  {% macro deeper_item(rec) %}
    <li class="deeper-item deeper-{{ rec.kind }}">
      <span class="kind-tag kind-{{ rec.kind }}">{{ rec.kind | upper }}</span>
      <div class="deeper-body">
        <a class="deeper-title" href="{{ rec.url }}">{{ rec.title }}</a>
        {% if rec.kind == 'book' %}
        <p class="deeper-meta">{{ rec.author }} — verified via {{ rec.verified_via }}</p>
        <p class="book-disclaimer">Bookshop.org search link — we make no money from book sales.</p>
        {% endif %}
      </div>
    </li>
  {% endmacro %}

  {% macro story_block(item, size) %}
    <article class="story-block {{ size }}-story">
      <p class="category-badge">{{ item.story.topic | upper }}</p>
      {% if item.story.is_satire %}<p class="satire-badge">SATIRE</p>{% endif %}
      {% if item.fact_check %}<p class="factcheck-badge">FACT-CHECKED CLAIM NEARBY</p>{% endif %}
      {% if size == 'lead' %}
      <h2 class="headline">{{ item.story.title }}</h2>
      {% else %}
      <h3 class="headline">{{ item.story.title }}</h3>
      {% endif %}
      <p class="sources">{{ item.story.sources | join(', ') }}</p>
      <p class="summary">{{ item.summary }}</p>

      {% if item.video_path %}
      <video class="story-video" controls preload="none" playsinline>
        <source src="{{ item.video_path }}" type="video/mp4">
      </video>
      {% endif %}

      {% if item.fact_check %}
      <div class="factcheck-notice">
        <p class="factcheck-heading">A related claim was independently fact-checked</p>
        <p class="factcheck-quote">“{{ item.fact_check.claim_text }}”</p>
        <p class="factcheck-rating">Rated <strong>{{ item.fact_check.rating }}</strong> by {{ item.fact_check.publisher }} —
          <a href="{{ item.fact_check.url }}">read the full fact-check</a></p>
        <p class="factcheck-caveat">This is a claim judged similar to this headline, not necessarily about the exact same story — follow the link and judge for yourself.</p>
      </div>
      {% endif %}

      {% if item.books or item.articles or item.sourced_from %}
      <div class="go-deeper">
        <h4>Go deeper</h4>
        <ul class="deeper-list">
          {% for article in item.articles %}{{ deeper_item(article) }}{% endfor %}
          {% for book in item.books %}{{ deeper_item(book) }}{% endfor %}
          {% for source in item.sourced_from %}{{ deeper_item(source) }}{% endfor %}
        </ul>
      </div>
      {% endif %}
    </article>
  {% endmacro %}

  <main>
    {{ story_block(lead, 'lead') }}

    {% if rest %}
    <section class="also-today">
      <h3 class="section-heading">Also today</h3>
      <div class="also-grid">
        {% for item in rest %}
        {{ story_block(item, 'secondary') }}
        {% endfor %}
      </div>
    </section>
    {% endif %}
  </main>

  <footer>
    <p>Built daily from RSS feeds, summarized locally, book links verified via Open Library / Google Books.</p>
    <p class="disclaimer">NewsHelper draws headlines and source material from third-party outlets we do not control; their accuracy, availability, and completeness may vary, and results may differ from what you'd find checking those sources directly. This site is provided for entertainment and educational purposes only — it is not a substitute for verified reporting or professional advice. Please confirm anything important directly with primary sources.</p>
  </footer>
</body>
</html>
